{
  "name": "@hanzo/sites",
  "version": "0.1.0",
  "private": true,
  "description": "One branded site shell, four hosts: erp / crm / cms / help. The Hanzo Framework DocType engine with the module fixed per hostname.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "postbuild": "gui-css-check",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "audit": "playwright test -c audit/audit.config.ts"
  },
  "dependencies": {
    "@hanzo/brand": "catalog:",
    "@hanzo/data": "catalog:",
    "@hanzo/design": "catalog:",
    "@hanzo/gui": "catalog:",
    "@hanzo/iam": "catalog:",
    "@hanzo/ui": "catalog:",
    "@hanzogui/config": "catalog:",
    "@hanzogui/lucide-icons-2": "catalog:",
    "@hanzogui/next-theme": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native-svg": "catalog:",
    "react-native-web": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "@hanzo/ui": "$@hanzo/ui"
  },
  "packageManager": "pnpm@11.24.0"
}
