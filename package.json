{
  "name": "@hanzo/sites",
  "version": "0.1.0",
  "private": true,
  "description": "One branded site shell, four hosts: erp / crm / cms / help. The Hanzo Framework DocType engine with the module fixed per hostname.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "postbuild": "gui-css-check",
    "start": "next start -p 3100",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "audit": "playwright test -c audit/audit.config.ts"
  },
  "dependencies": {
    "@hanzo/brand": "^1.4.5",
    "@hanzo/data": "^1.2.2",
    "@hanzo/gui": "^8.1.0",
    "@hanzo/iam": "^0.21.6",
    "@hanzo/ui": "^8.0.76",
    "@hanzogui/config": "^8.0.1",
    "@hanzogui/lucide-icons-2": "^8.0.1",
    "@hanzogui/next-theme": "^8.0.0",
    "next": "15.5.19",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native-svg": "15.15.5",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@hanzo/ui": "$@hanzo/ui"
  }
}
